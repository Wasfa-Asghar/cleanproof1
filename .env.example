# --- Public site URL (required in production hosting) ---
# Used for sitemap.xml, robots.txt, canonical links, Open Graph, and marketing JSON-LD.
# Must be https with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://thehouseofveynor.uk

# --- Application URL (required in production for billing & emails) ---
# Usually the same as NEXT_PUBLIC_SITE_URL. Used for checkout redirects, password reset
# links, and Mollie webhooks (APP_URL/api/webhooks/mollie). Not used for SEO when loopback.
APP_URL=https://thehouseofveynor.uk

# DATABASE_URL=
# AUTH_SECRET=
